# Public client configuration only. Never commit secret/service-role/database keys.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=replace-with-project-publishable-key

# Server/worker configuration: populate only in a secret manager or local ignored .env.
SUPABASE_SERVICE_ROLE_KEY=replace-at-runtime
DATABASE_URL=replace-at-runtime
APP_ENV=development
