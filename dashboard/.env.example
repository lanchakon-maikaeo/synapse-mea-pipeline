# Public browser configuration. Production is guarded at build time: it must use
# the approved production project shown in docs/PRODUCTION_REBUILD_2026-07-24.md.
# Preview and local environments may point to their own project.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-project-publishable-key
# Server-only exact origin pin required only when production uses a custom
# Supabase domain instead of a standard <20-char-ref>.supabase.co project URL.
SUPABASE_ALLOWED_ORIGIN=

# Leave blank to use the same-origin Next.js API at /api.
NEXT_PUBLIC_API_BASE_URL=

# Server-only road engine used by /api/v1/transport/optimize. Production must
# point to a controlled HTTPS OSRM-compatible endpoint. Never expose this URL
# through NEXT_PUBLIC_* when the service is private.
ROUTING_ENGINE_URL=https://routing.example.mea
ROUTING_ENGINE_PROFILE=driving
ROUTING_ENGINE_TIMEOUT_MS=10000
ROUTING_ENGINE_MAX_CONCURRENCY=4
# Immutable OSM graph identifier retained with every production preview.
# Required pattern: <lowercase-label>-sha256-<64 lowercase hex>.
ROUTING_ENGINE_DATA_VERSION=osm-thailand-yyyy-mm-dd-sha256-REPLACE_WITH_64_LOWERCASE_HEX
# Optional server-only bearer token for the controlled routing gateway.
ROUTING_ENGINE_AUTH_TOKEN=

# Browser map tiles. Use a contracted or self-hosted OSM-derived tile service
# in production; tile.openstreetmap.org is suitable only for low-volume
# development subject to the OSM Foundation usage policy.
NEXT_PUBLIC_MAP_TILE_URL=https://tiles.example.mea/{z}/{x}/{y}.png
NEXT_PUBLIC_MAP_ATTRIBUTION=&copy; OpenStreetMap contributors
