# Public browser configuration. Vercel's mea-synapse-production project is
# guarded at build time: it must use the approved target in
# docs/PRODUCTION_REBUILD_2026-07-24.md. Preview, staging and local environments
# may point to their own project.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-project-publishable-key
# Server-only exact origin pin required only when production uses a custom
# Supabase domain instead of a standard <20-char-ref>.supabase.co project URL.
SUPABASE_ALLOWED_ORIGIN=

# Leave blank to use the same-origin Next.js API at /api.
NEXT_PUBLIC_API_BASE_URL=

# Server-only OpenRouter settings. LLM_MODEL uses an OpenRouter provider/model ID.
# Never prefix keys with NEXT_PUBLIC_. Redeploy after changing secrets.
LLM_API_KEY=
LLM_MODEL=openai/gpt-4o-mini
LLM_TEMPERATURE=0
LLM_TIMEOUT_MS=30000
# Document embeddings use baai/bge-m3 (1024 dimensions) via OpenRouter.
# Both chat and embeddings use LLM_API_KEY.

# Server-only road engine used by /api/v1/transport/optimize. Production must
# point to a controlled HTTPS OSRM-compatible endpoint. Never expose this URL
# through NEXT_PUBLIC_* when the service is private.
#
# Local development: build the graph with `scripts/prepare_osrm_graph.sh`, start
# the self-hosted engine with `docker compose --profile routing up -d osrm`, and
# set ROUTING_ENGINE_URL=http://localhost:5000 (loopback HTTP is accepted only
# outside production; a non-loopback or community host is rejected there).
ROUTING_ENGINE_URL=https://routing.example.mea
ROUTING_ENGINE_PROFILE=driving
ROUTING_ENGINE_TIMEOUT_MS=10000
ROUTING_ENGINE_MAX_CONCURRENCY=4
# Immutable OSM graph identifier retained with every production preview.
# Required pattern: <lowercase-label>-sha256-<64 lowercase hex>.
ROUTING_ENGINE_DATA_VERSION=osm-thailand-yyyy-mm-dd-sha256-REPLACE_WITH_64_LOWERCASE_HEX
# Optional server-only bearer token for the controlled routing gateway.
ROUTING_ENGINE_AUTH_TOKEN=

# Server-only on-demand OR-Tools worker. The API refreshes its attested
# Valhalla heartbeat before readiness/queue operations and invokes one queued
# job after an idempotent route-job request is accepted.
OPTIMIZATION_WORKER_URL=https://optimization-worker.example.mea
OPTIMIZATION_WORKER_AUTH_TOKEN=

# Browser map tiles. Use a contracted or self-hosted OSM-derived tile service
# in production; tile.openstreetmap.org is suitable only for low-volume
# development subject to the OSM Foundation usage policy.
NEXT_PUBLIC_MAP_TILE_URL=https://synapse-map-tiles.vercel.app/bmr.pmtiles
NEXT_PUBLIC_MAP_ATTRIBUTION=&copy; OpenStreetMap contributors &middot; Protomaps

# Server-only proactive alert worker; configure Preview/dev separately.
AGENTIC_ALERT_SERVICE_KEY=
AGENTIC_ALERT_CRON_SECRET=
# Daily summary: 07:30 Asia/Bangkok (00:30 UTC). The Preview scheduler calls
# /api/internal/agentic-alerts; Vercel's native cron targets Production only.
