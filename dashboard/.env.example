# Public browser configuration. These values may be overridden per Vercel
# environment without changing the application bundle.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-project-publishable-key

# Leave blank to use the same-origin Next.js API at /api.
NEXT_PUBLIC_API_BASE_URL=
