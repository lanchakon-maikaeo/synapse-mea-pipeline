{
  "name": "mea-synapse-production",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/verify-production-config.mjs && next build --webpack",
    "start": "next start",
    "test": "next build --webpack && node --test tests/rendered-html.test.mjs tests/pipeline-orchestration.test.mjs tests/pipeline-validation.test.mjs tests/route-optimizer.test.mjs tests/transport-truthfulness.test.mjs tests/production-configuration.test.mjs",
    "verify": "npm run lint && npm run test && npm run db:check && node --test tests/database-contract.test.mjs",
    "lint": "eslint . --ignore-pattern .next --ignore-pattern dist --ignore-pattern .vinext --ignore-pattern .wrangler",
    "db:generate": "drizzle-kit generate --config=drizzle.config.ts",
    "db:check": "tsc --noEmit",
    "db:validate": "drizzle-kit check --config=drizzle.config.ts && node --test tests/database-contract.test.mjs",
    "smoke:deployment": "node scripts/smoke-deployment.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.8",
    "drizzle-orm": "0.45.2",
    "leaflet": "1.9.4",
    "next": "16.2.11",
    "protomaps-leaflet": "5.1.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-leaflet": "5.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/leaflet": "1.9.21",
    "@types/node": "22.19.19",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.11",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  },
  "overrides": {
    "@babel/core@^7.0.0": "7.29.7",
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    },
    "brace-expansion": "5.0.8",
    "fast-uri@^3.0.0": "3.1.4",
    "js-yaml@^4.0.0": "4.3.0",
    "minimatch": "10.2.5",
    "postcss": "8.5.23",
    "sharp": "0.35.0"
  },
  "type": "module"
}
