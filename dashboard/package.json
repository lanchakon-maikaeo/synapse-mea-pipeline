{
  "name": "mea-synapse-staging",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "test": "next build --webpack && node --test tests/rendered-html.test.mjs tests/pipeline-orchestration.test.mjs tests/pipeline-validation.test.mjs",
    "verify": "npm run lint && npm run test && npm run db:check && node --test tests/database-contract.test.mjs",
    "lint": "eslint . --ignore-pattern .next --ignore-pattern dist --ignore-pattern .vinext --ignore-pattern .wrangler",
    "db:generate": "drizzle-kit generate --config=drizzle.config.ts",
    "db:check": "tsc --noEmit",
    "db:validate": "drizzle-kit check --config=drizzle.config.ts && node --test tests/database-contract.test.mjs",
    "db:migrate:staging": "drizzle-kit migrate --config=drizzle.staging.config.ts",
    "smoke:deployment": "node scripts/smoke-deployment.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.8",
    "drizzle-orm": "0.45.2",
    "next": "16.2.11",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.19.19",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.11",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  },
  "overrides": {
    "brace-expansion@^1.0.0": "1.1.16",
    "brace-expansion@^5.0.0": "5.0.7",
    "fast-uri@^3.0.0": "3.1.4",
    "js-yaml@^4.0.0": "4.3.0",
    "postcss": "8.5.14",
    "sharp": "0.35.0"
  },
  "type": "module"
}
