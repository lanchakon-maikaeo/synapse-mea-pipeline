FROM stefda/osmium-tool:latest@sha256:d2321d0e926f77ead7547b4b35f5cf98d9fd74043673cecc4fc2bb7cce06ff63 AS extract

COPY bmr-2026-08-20.osm.pbf /graph/bmr.osm.pbf
RUN echo "b41ce7d5c5f2782fe4af222efede4edab366822cec0c3ed47dbc5c503b429351  /graph/bmr.osm.pbf" | sha256sum -c -

FROM golang:1.24.6-alpine3.22@sha256:c8c5f95d64aa79b6547f3b626eb84b16a7ce18a139e3e9ca19a8c078b85ba80d AS proxy-build
WORKDIR /src
COPY proxy.go .
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /routing-proxy ./proxy.go

FROM ghcr.io/gis-ops/docker-valhalla/valhalla:latest@sha256:060da5b92e6024a67f65135c236d918b021d63e73d1808a0d55b7e7cbd17240c AS tiles
USER root
RUN chown 59999:59999 /custom_files
COPY --from=extract --chown=59999:59999 /graph/bmr.osm.pbf /custom_files/bmr.osm.pbf
USER 59999:59999
ENV serve_tiles=False \
    build_tar=True \
    use_tiles_ignore_pbf=False \
    build_elevation=False \
    build_admins=False \
    build_time_zones=False \
    server_threads=4
RUN /valhalla/scripts/run.sh build_tiles

FROM ghcr.io/gis-ops/docker-valhalla/valhalla:latest@sha256:060da5b92e6024a67f65135c236d918b021d63e73d1808a0d55b7e7cbd17240c AS runtime
USER root
RUN chown 59999:59999 /custom_files
COPY --from=tiles --chown=59999:59999 /custom_files/valhalla.json /custom_files/valhalla.json
COPY --from=tiles --chown=59999:59999 /custom_files/valhalla_tiles.tar /custom_files/valhalla_tiles.tar
COPY --from=proxy-build /routing-proxy /usr/local/bin/routing-proxy
USER 59999:59999
ENV UPSTREAM_URL=http://127.0.0.1:8002 \
    ENGINE_HEALTH_PATH=/status \
    INJECT_OSM_CHANGESET=0 \
    use_tiles_ignore_pbf=True \
    build_tar=True \
    serve_tiles=True \
    server_threads=2
ENTRYPOINT []
CMD ["sh", "-ec", "/valhalla/scripts/run.sh build_tiles & exec /usr/local/bin/routing-proxy"]
