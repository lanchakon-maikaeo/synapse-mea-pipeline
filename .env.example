# Copy to .env and protect it with chmod 600. Never commit the populated file.
DATABASE_URL=postgresql://application_user:replace-at-runtime@database.example:5432/postgres?sslmode=require
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_JWT_SECRET=replace-at-runtime
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json
API_CORS_ORIGINS=http://localhost:3000
SYNAPSE_ENVIRONMENT=production
API_RATE_LIMIT_PER_MINUTE=120
API_MAX_REQUEST_BODY_BYTES=1048576
METRICS_TOKEN=replace-with-random-hex
API_BIND_ADDRESS=127.0.0.1
API_PORT=8000
WORKER_ID=worker-01
WORKER_POLL_SECONDS=30
WORKER_API_KEY=replace-with-random-hex
ALLOW_HAVERSINE_FALLBACK=false
VALHALLA_URL=http://valhalla:8002
VALHALLA_AUTH_TOKEN=
VALHALLA_TILE_URLS=https://controlled-object-store.example/osm/thailand-2026-07-25.osm.pbf
# Required pattern: <lowercase-label>-sha256-<64 lowercase hex>.
VALHALLA_TILESET_VERSION=thailand-yyyy-mm-dd-sha256-REPLACE_WITH_64_LOWERCASE_HEX
VALHALLA_OSM_CHANGESET=REPLACE_WITH_CONTROLLED_OSM_CHANGESET
# Road-preview engine for /v1/transport/optimize. For local development, build
# the graph with scripts/prepare_osrm_graph.sh, start the self-hosted engine
# with `docker compose --profile routing up -d osrm`, and set
# ROUTING_ENGINE_URL=http://localhost:5000 (loopback HTTP is accepted only
# outside production).
ROUTING_ENGINE_URL=https://routing.example.mea
ROUTING_ENGINE_PROFILE=driving
ROUTING_ENGINE_TIMEOUT_MS=10000
ROUTING_ENGINE_MAX_CONCURRENCY=4
# Required pattern: <lowercase-label>-sha256-<64 lowercase hex>. The prepare
# script prints this value from the extract digest it built.
ROUTING_ENGINE_DATA_VERSION=osm-thailand-yyyy-mm-dd-sha256-REPLACE_WITH_64_LOWERCASE_HEX
ROUTING_ENGINE_AUTH_TOKEN=
# Self-hosted OSRM Compose service (docker-compose.yml, profile `routing`).
OSRM_BIND_ADDRESS=127.0.0.1
# On macOS, port 5000 is used by the AirPlay Receiver; set OSRM_PORT=5050 (or
# disable AirPlay Receiver) and match ROUTING_ENGINE_URL to it.
OSRM_PORT=5000
OSRM_GRAPH_NAME=thailand
# Optional: clip the graph to a bounding box (left,bottom,right,top) when the
# full extract exceeds the Docker VM's memory. Bangkok Metropolitan Region:
#   OSRM_CLIP_BBOX=100.2,13.4,101.0,14.1
NEXT_PUBLIC_MAP_TILE_URL=https://mea-synapse-map-tiles.vercel.app/bmr.pmtiles
NEXT_PUBLIC_MAP_ATTRIBUTION=&copy; OpenStreetMap contributors &middot; Protomaps
IMPORT_DIRECTORY=./imports
